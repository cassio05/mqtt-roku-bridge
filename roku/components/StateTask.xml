<?xml version="1.0" encoding="utf-8" ?>

<component name="StateTask" extends="Task">

    <script
        type="text/brightscript"
        uri="pkg:/components/StateTask.brs" />

    <interface>

        <field
            id="url"
            type="string" />

        <field
            id="authHeader"
            type="string" />

        <field
            id="relayId"
            type="integer" />

        <field
            id="response"
            type="string" />

        <field
            id="success"
            type="boolean"
            value="false" />

    </interface>

</component>